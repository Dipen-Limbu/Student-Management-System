@model List<Student_Management_System.Models.Student>

@{
    ViewData["Title"] = "My Students";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    int total = Model?.Count ?? 0;
}

<div class="max-w-7xl mx-auto">

    <!-- Page Header -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h2 class="text-2xl font-bold text-textDark mb-1">My Students</h2>
            <p class="text-textMuted text-sm">@total student@(total == 1 ? "" : "s") enrolled across your courses.</p>
        </div>
        <!-- Search -->
        <div class="relative">
            <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" id="studentSearch" placeholder="Search students…"
                   oninput="filterStudents(this.value)"
                   class="pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500 transition-all w-64" />
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center py-24 bg-white rounded-2xl border border-gray-100 shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-400 flex items-center justify-center mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-textDark mb-1">No students found</h3>
            <p class="text-sm text-textMuted">No students are enrolled in your courses yet.</p>
        </div>
    }
    else
    {
        <!-- Students Table -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

            <!-- Table Header -->
            <div class="grid gap-4 px-6 py-3 border-b border-gray-100 bg-gray-50/60"
                 style="grid-template-columns: 2fr 1fr 1.2fr 120px 80px;">
                <span class="text-xs font-semibold text-blue-500 uppercase tracking-wider">Student</span>
                <span class="text-xs font-semibold text-blue-500 uppercase tracking-wider">Roll No.</span>
                <span class="text-xs font-semibold text-blue-500 uppercase tracking-wider">Course</span>
                <span class="text-xs font-semibold text-blue-500 uppercase tracking-wider">Attendance</span>
                <span class="text-xs font-semibold text-blue-500 uppercase tracking-wider">Enrolled</span>
            </div>

            <!-- Table Body -->
            <div id="studentsTableBody">
                @{int rowIdx = 0;}
                @foreach (var student in Model)
                {
                    // Attendance stats attached via ViewData in controller
                    int attPct = ViewData[$"att_{student.StudentId}"] is int p ? p : 0;
                    var isLast = (rowIdx == Model.Count - 1);

                    var pctColor = attPct >= 75 ? "text-green-600" :
                                   attPct >= 50 ? "text-orange-500" :
                                                  "text-red-500";
                    var barColor = attPct >= 75 ? "#22c55e" :
                                   attPct >= 50 ? "#f97316" :
                                                  "#ef4444";

                    <div class="student-row group grid gap-4 items-center px-6 py-3.5 hover:bg-gray-50/60 transition-colors @(isLast ? "" : "border-b border-gray-100")"
                         style="grid-template-columns: 2fr 1fr 1.2fr 120px 80px;"
                         data-name="@student.FullName.ToLower()" data-roll="@student.RollNo.ToLower()" data-course="@(student.Course?.ToLower() ?? "")">

                        <!-- Name + Email -->
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-xs border border-blue-100 shrink-0">
                                @student.Initials
                            </div>
                            <div>
                                <span class="text-sm font-semibold text-gray-800">@student.FullName</span>
                                @if (!string.IsNullOrEmpty(student.Email))
                                {
                                    <p class="text-xs text-gray-400">@student.Email</p>
                                }
                            </div>
                        </div>

                        <!-- Roll No -->
                        <div class="text-sm text-gray-500 font-mono">@student.RollNo</div>

                        <!-- Course -->
                        <div class="text-sm text-gray-700 truncate">@(student.Course ?? "—")</div>

                        <!-- Attendance bar -->
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-xs font-bold @pctColor">@attPct%</span>
                            </div>
                            <div class="h-1.5 w-full bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full rounded-full transition-all duration-500"
                                     style="width: @attPct%; background-color: @barColor;"></div>
                            </div>
                        </div>

                        <!-- Enrolled On -->
                        <div class="text-xs text-gray-400 whitespace-nowrap">
                            @(student.EnrolledOn?.ToString("MMM yyyy") ?? "—")
                        </div>
                    </div>
                    rowIdx++;
                }
            </div>
        </div>

        <!-- Pagination / count footer -->
        <div class="mt-3 text-xs text-textMuted text-right px-1">
            Showing <span id="visibleCount">@total</span> of @total students
        </div>
    }
</div>

@section Scripts {
<script>
    function filterStudents(q) {
        const rows = document.querySelectorAll('.student-row');
        q = q.toLowerCase().trim();
        let visible = 0;
        rows.forEach(row => {
            const match = !q ||
                row.dataset.name?.includes(q) ||
                row.dataset.roll?.includes(q) ||
                row.dataset.course?.includes(q);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        const vc = document.getElementById('visibleCount');
        if (vc) vc.textContent = visible;
    }
</script>
}
