@model List<Student_Management_System.Models.Student>

@{
    ViewData["Title"] = "Attendance";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";

    var courses = ViewBag.Courses as List<Student_Management_System.Models.Course> ?? new List<Student_Management_System.Models.Course>();
    int selectedCourseId = ViewBag.SelectedCourseId is int sci ? sci : 0;
    string selectedDate  = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");

    var existingAtt = ViewBag.ExistingAttendance as List<Student_Management_System.Models.Attendance>
                      ?? new List<Student_Management_System.Models.Attendance>();
}

<div class="max-w-6xl mx-auto">

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="successBanner" class="mb-4 flex items-center gap-3 px-5 py-3.5 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm font-medium">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @TempData["SuccessMessage"]
        </div>
        <script>setTimeout(() => { const b = document.getElementById('successBanner'); if (b) b.remove(); }, 4000);</script>
    }

    <!-- Page Header -->
    <div class="flex items-start justify-between mb-6">
        <div>
            <h2 class="text-2xl font-bold text-textDark mb-1">Attendance</h2>
            <p class="text-sm text-textMuted">Mark and track attendance for your courses.</p>
        </div>
        <button type="submit" form="attendanceForm"
                class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Save changes
        </button>
    </div>

    <!-- Filters Row -->
    <form method="get" action="@Url.Action("Attendance", "Teacher")" class="flex flex-wrap items-center gap-3 mb-5">
        <!-- Course Selector -->
        <div class="relative">
            <select name="courseId" onchange="this.form.submit()"
                    class="appearance-none pl-3 pr-8 py-2 text-sm border border-gray-300 rounded-lg bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500 cursor-pointer transition-all">
                @foreach (var c in courses)
                {
                    <option value="@c.CourseId" selected="@(c.CourseId == selectedCourseId ? "selected" : null)">
                        @c.CourseName
                    </option>
                }
                @if (!courses.Any())
                {
                    <option value="0">No courses found</option>
                }
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2 text-gray-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </div>
        </div>

        <!-- Date Picker -->
        <input type="date" name="date" value="@selectedDate" onchange="this.form.submit()"
               class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500 transition-all cursor-pointer" />
    </form>

    <!-- Stats Row -->
    @{
        int presentCount = existingAtt.Count(a => a.Status == "Present");
        int absentCount  = existingAtt.Count(a => a.Status == "Absent");
        int leaveCount   = existingAtt.Count(a => a.Status == "Leave");
        int lateCount    = existingAtt.Count(a => a.Status == "Late");
        int totalCount   = Model?.Count ?? 0;
    }
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-5">
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm">
            <p class="text-xs font-medium text-textMuted mb-1">Present</p>
            <p class="text-2xl font-bold text-green-600" id="countPresent">@presentCount</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm">
            <p class="text-xs font-medium text-textMuted mb-1">Absent</p>
            <p class="text-2xl font-bold text-red-500" id="countAbsent">@absentCount</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm">
            <p class="text-xs font-medium text-textMuted mb-1">Leave</p>
            <p class="text-2xl font-bold text-blue-500" id="countLeave">@leaveCount</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm">
            <p class="text-xs font-medium text-textMuted mb-1">Late</p>
            <p class="text-2xl font-bold text-orange-400" id="countLate">@lateCount</p>
        </div>
    </div>

    <!-- Attendance Form -->
    <form id="attendanceForm" method="post" action="@Url.Action("Attendance", "Teacher")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="courseId" value="@selectedCourseId" />
        <input type="hidden" name="date" value="@selectedDate" />

        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">

            <!-- Table Header -->
            <div class="grid gap-4 px-5 py-3 border-b border-gray-100 bg-gray-50/60"
                 style="grid-template-columns: 1fr 160px auto;">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Student</span>
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Roll No.</span>
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</span>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="flex flex-col items-center justify-center py-16 text-center px-6">
                    <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-400 flex items-center justify-center mb-3">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                        </svg>
                    </div>
                    <p class="text-sm font-semibold text-textDark mb-1">No students enrolled</p>
                    <p class="text-xs text-textMuted">No students found for the selected course.</p>
                </div>
            }
            else
            {
                int rowIdx = 0;
                foreach (var student in Model)
                {
                    var att = existingAtt.FirstOrDefault(a => a.StudentId == student.StudentId);
                    var currentStatus = att?.Status ?? "Present";
                    var isLast = (rowIdx == (Model.Count - 1));

                    <div class="grid gap-4 items-center px-5 py-3.5 hover:bg-gray-50/50 transition-colors @(isLast ? "" : "border-b border-gray-100")"
                         style="grid-template-columns: 1fr 160px auto;">

                        <!-- Student Name -->
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-semibold text-xs border border-blue-100 shrink-0">
                                @student.Initials
                            </div>
                            <div>
                                <span class="text-sm font-medium text-gray-800">@student.FullName</span>
                                @if (!string.IsNullOrEmpty(student.Email))
                                {
                                    <p class="text-xs text-gray-400">@student.Email</p>
                                }
                            </div>
                        </div>

                        <!-- Roll No -->
                        <div class="text-sm text-gray-500">@student.RollNo</div>

                        <!-- Status Buttons -->
                        <div class="flex items-center gap-1.5" data-student-id="@student.StudentId">
                            @foreach (var s in new[] { "Present", "Absent", "Leave", "Late" })
                            {
                                var isActive = currentStatus == s;
                                var activeClass = s switch
                                {
                                    "Present" => "bg-green-500 text-white border-transparent",
                                    "Absent"  => "bg-red-500 text-white border-transparent",
                                    "Leave"   => "bg-blue-500 text-white border-transparent",
                                    "Late"    => "bg-orange-400 text-white border-transparent",
                                    _         => ""
                                };
                                var inactiveClass = "bg-white text-gray-400 border-gray-200 hover:border-gray-300 hover:bg-gray-50";
                                <button type="button"
                                        onclick="setStatus(@student.StudentId, '@s', this)"
                                        class="att-btn px-3 py-1 rounded-full text-xs font-semibold border transition-all focus:outline-none @(isActive ? activeClass : inactiveClass)">
                                    @s
                                </button>
                            }
                            <!-- Hidden input for form submission -->
                            <input type="hidden" name="statuses[@student.StudentId]" id="status_@student.StudentId" value="@currentStatus" />
                        </div>
                    </div>
                    rowIdx++;
                }
            }
        </div>
    </form>
</div>

@section Scripts {
<script>
    const activeClasses = {
        Present: "bg-green-500 text-white border-transparent",
        Absent:  "bg-red-500 text-white border-transparent",
        Leave:   "bg-blue-500 text-white border-transparent",
        Late:    "bg-orange-400 text-white border-transparent"
    };
    const inactiveClass = "bg-white text-gray-400 border-gray-200 hover:border-gray-300 hover:bg-gray-50";

    const countIds = { Present: 'countPresent', Absent: 'countAbsent', Leave: 'countLeave', Late: 'countLate' };

    function setStatus(studentId, newStatus, clickedBtn) {
        const container = clickedBtn.closest('[data-student-id]');
        const buttons   = container.querySelectorAll('.att-btn');
        const input     = document.getElementById('status_' + studentId);
        const oldStatus = input.value;

        // Update counter display
        if (oldStatus !== newStatus) {
            const oldEl = document.getElementById(countIds[oldStatus]);
            const newEl = document.getElementById(countIds[newStatus]);
            if (oldEl) oldEl.textContent = Math.max(0, parseInt(oldEl.textContent) - 1);
            if (newEl) newEl.textContent = parseInt(newEl.textContent) + 1;
        }

        // Update button styles
        buttons.forEach(btn => {
            const s = btn.textContent.trim();
            btn.className = 'att-btn px-3 py-1 rounded-full text-xs font-semibold border transition-all focus:outline-none ' +
                            (s === newStatus ? activeClasses[s] : inactiveClass);
        });

        // Update hidden input
        input.value = newStatus;
    }
</script>
}
