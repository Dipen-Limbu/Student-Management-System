@model IEnumerable<Student_Management_System.Models.Attendance>
@{
    ViewData["Title"] = "Attendance";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var records = Model.ToList();
    var statuses = new[] { "Present", "Absent", "Leave", "Late" };
}

<div class="max-w-6xl mx-auto">

    <!-- Page Header -->
    <div class="flex items-start justify-between mb-6">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-1">Attendance</h2>
            <p class="text-sm text-blue-500 font-medium">View and mark attendance records</p>
        </div>
        <button id="saveChangesBtn"
                onclick="saveAttendance()"
                class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white text-sm font-semibold rounded-xl shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Save changes
        </button>
    </div>

    <!-- Attendance Table -->
    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.04)]">

        <!-- Table Header -->
        <div class="grid gap-4 px-5 py-3 border-b border-gray-100 bg-gray-50/60"
             style="grid-template-columns: 1fr 180px auto;">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Student</span>
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</span>
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</span>
        </div>

        <!-- Table Body -->
        @if (!records.Any())
        {
            <div class="flex flex-col items-center justify-center py-16">
                <svg class="w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <p class="text-sm text-gray-500">No attendance records found.</p>
                <p class="text-xs text-gray-400 mt-1">Records will appear here once teachers mark attendance.</p>
            </div>
        }
        else
        {
            @for (int i = 0; i < records.Count; i++)
            {
                var rec = records[i];
                var studentName = rec.Student?.FullName ?? "Unknown Student";
                var isLast = i == records.Count - 1;
                var activeStatus = rec.Status;

                <div class="grid gap-4 items-center px-5 py-3.5 hover:bg-gray-50/50 transition-colors @(isLast ? "" : "border-b border-gray-100")"
                     style="grid-template-columns: 1fr 180px auto;">

                    <!-- Student Name -->
                    <div class="text-sm font-medium text-gray-800">@studentName</div>

                    <!-- Date -->
                    <div class="text-sm text-gray-400">@rec.Date.ToString("yyyy-MM-dd")</div>

                    <!-- Status Buttons -->
                    <div class="flex items-center gap-1.5">
                        @foreach (var s in statuses)
                        {
                            var isActive = activeStatus == s;
                            var activeClass = s switch {
                                "Present" => "bg-green-500 text-white border-transparent",
                                "Absent"  => "bg-red-500 text-white border-transparent",
                                "Leave"   => "bg-blue-500 text-white border-transparent",
                                "Late"    => "bg-orange-400 text-white border-transparent",
                                _         => ""
                            };
                            var btnClass = isActive ? activeClass : "bg-white text-gray-400 border-gray-200 hover:border-gray-300 hover:bg-gray-50";
                            <button class="px-3 py-1 rounded-full text-xs font-semibold border transition-all focus:outline-none status-btn @btnClass"
                                    data-rid="@rec.AttendanceId"
                                    data-status="@s"
                                    onclick="setStatus(@rec.AttendanceId, '@s', this)">
                                @s
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- Save Toast Notification -->
    <div id="saveToast"
         class="fixed bottom-6 right-6 z-50 hidden items-center gap-3 px-5 py-3.5 bg-gray-900 text-white text-sm font-medium rounded-xl shadow-xl">
        <svg class="w-5 h-5 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Attendance saved successfully!</span>
    </div>
</div>

@section Scripts {
<script>
    const activeClasses = {
        Present: "bg-green-500 text-white border-transparent",
        Absent:  "bg-red-500 text-white border-transparent",
        Leave:   "bg-blue-500 text-white border-transparent",
        Late:    "bg-orange-400 text-white border-transparent",
    };
    const inactiveClass = "bg-white text-gray-400 border-gray-200 hover:border-gray-300 hover:bg-gray-50";

    function setStatus(recordId, newStatus, clickedBtn) {
        // Get all buttons for this row
        const allBtns = document.querySelectorAll(`[data-rid="${recordId}"]`);
        allBtns.forEach(btn => {
            const s = btn.getAttribute("data-status");
            btn.className = `px-3 py-1 rounded-full text-xs font-semibold border transition-all focus:outline-none status-btn ${s === newStatus ? activeClasses[s] : inactiveClass}`;
        });
    }

    function saveAttendance() {
        const btn = document.getElementById("saveChangesBtn");
        btn.disabled = true;
        btn.textContent = "Saving…";
        setTimeout(() => {
            btn.disabled = false;
            btn.textContent = "Save changes";
            showToast();
        }, 800);
    }

    function showToast() {
        const toast = document.getElementById("saveToast");
        toast.classList.remove("hidden");
        toast.classList.add("flex");
        setTimeout(() => {
            toast.classList.add("hidden");
            toast.classList.remove("flex");
        }, 3000);
    }
</script>
}
