@model IEnumerable<Student_Management_System.Models.User>
@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-6xl mx-auto">

    <!-- Page Header -->
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-1">Users</h2>
        <p class="text-sm text-gray-500">@Model.Count() account@(Model.Count() == 1 ? "" : "s") across all roles</p>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.04)]">

        <!-- Table Header -->
        <div class="grid gap-4 px-6 py-3 border-b border-gray-100 bg-gray-50/60"
             style="grid-template-columns: 1.6fr 2fr 140px 120px;">
            <span class="text-xs font-semibold text-blue-500 uppercase tracking-wider">User</span>
            <span class="text-xs font-semibold text-blue-500 uppercase tracking-wider">Email</span>
            <span class="text-xs font-semibold text-blue-500 uppercase tracking-wider">Role</span>
            <span class="text-xs font-semibold text-blue-500 uppercase tracking-wider">Status</span>
        </div>

        <!-- Table Body -->
        <div id="usersTableBody">
            @{
                var roleColors = new Dictionary<string, string>
                {
                    ["Teacher"] = "bg-teal-50 text-teal-600 border border-teal-200",
                    ["Student"] = "bg-green-50 text-green-600 border border-green-200",
                    ["Admin"]   = "bg-blue-50 text-blue-600 border border-blue-200"
                };
                int rowIdx = 0;
            }
            @foreach (var u in Model)
            {
                var initials = string.Join("", (u.FullName ?? u.Username).Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0]).Take(2)).ToUpper();
                if (string.IsNullOrEmpty(initials)) initials = u.Username.Substring(0, Math.Min(2, u.Username.Length)).ToUpper();
                var displayName = u.FullName ?? u.Username;
                var roleClass = roleColors.GetValueOrDefault(u.Role, "bg-gray-50 text-gray-600 border border-gray-200");
                var isLast = rowIdx == Model.Count() - 1;

                <div class="user-row grid gap-4 items-center px-6 py-3.5 hover:bg-gray-50/60 transition-colors @(isLast ? "" : "border-b border-gray-100")"
                     style="grid-template-columns: 1.6fr 2fr 140px 120px;"
                     data-id="@u.UserId"
                     data-name="@displayName"
                     data-email="@u.Username"
                     data-role="@u.Role"
                     data-status="active">

                    <!-- Name + Initials -->
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-xs border border-blue-100 shrink-0">
                            @initials
                        </div>
                        <span class="text-sm font-semibold text-gray-800 truncate">@displayName</span>
                    </div>

                    <!-- Email -->
                    <div class="text-sm text-gray-500 truncate">@u.Username</div>

                    <!-- Role Badge -->
                    <div>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @roleClass">@u.Role</span>
                    </div>

                    <!-- Status + Actions -->
                    <div class="flex items-center gap-3">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-green-600 border border-green-100">active</span>
                        <button onclick="openEdit(this.closest('.user-row'))" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-all" title="Edit">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                        </button>
                        <button onclick="openDelete(this.closest('.user-row'))" class="p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all" title="Delete">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </div>
                </div>
                rowIdx++;
            }

            @if (!Model.Any())
            {
                <div class="flex flex-col items-center justify-center py-16">
                    <p class="text-sm text-gray-500">No users found in the database.</p>
                </div>
            }
        </div>

    <!-- ── Modals ─────────────────────────────────────────────────────────────── -->

    <!-- Edit User Modal -->
    <div id="editModal"
         class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                <h3 class="text-base font-bold text-gray-900">Edit User</h3>
                <button onclick="closeModal('editModal')"
                        class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="px-6 py-5 space-y-4">
                <div class="space-y-1.5">
                    <label class="block text-sm font-semibold text-gray-700">Name</label>
                    <input id="editName" type="text"
                           class="block w-full px-4 py-2.5 border border-gray-200 rounded-xl bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500 text-sm transition-all" />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-sm font-semibold text-gray-700">Email</label>
                    <input id="editEmail" type="email"
                           class="block w-full px-4 py-2.5 border border-gray-200 rounded-xl bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500 text-sm transition-all" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="block text-sm font-semibold text-gray-700">Role</label>
                        <select id="editRole"
                                class="block w-full px-3 py-2.5 border border-gray-200 rounded-xl bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500 text-sm transition-all">
                            <option value="Teacher">Teacher</option>
                            <option value="Student">Student</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label class="block text-sm font-semibold text-gray-700">Status</label>
                        <select id="editStatus"
                                class="block w-full px-3 py-2.5 border border-gray-200 rounded-xl bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500 text-sm transition-all">
                            <option value="active">active</option>
                            <option value="inactive">inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="flex justify-end gap-3 px-6 py-4 border-t border-gray-100 bg-gray-50/40">
                <button onclick="closeModal('editModal')"
                        class="px-4 py-2 text-sm font-semibold text-gray-600 bg-white border border-gray-200 rounded-xl hover:bg-gray-50 transition-colors">
                    Cancel
                </button>
                <button onclick="saveEdit()"
                        class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors">
                    Save changes
                </button>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal"
         class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
            <div class="px-6 py-5 text-center">
                <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </div>
                <h3 class="text-base font-bold text-gray-900 mb-1">Delete User</h3>
                <p class="text-sm text-gray-500">Are you sure you want to delete <span id="deleteUserName" class="font-semibold text-gray-700"></span>? This action cannot be undone.</p>
            </div>
            <div class="flex gap-3 px-6 pb-5">
                <button onclick="closeModal('deleteModal')"
                        class="flex-1 px-4 py-2 text-sm font-semibold text-gray-600 bg-white border border-gray-200 rounded-xl hover:bg-gray-50 transition-colors">
                    Cancel
                </button>
                <button onclick="confirmDelete()"
                        class="flex-1 px-4 py-2 text-sm font-semibold text-white bg-red-500 rounded-xl hover:bg-red-600 transition-colors">
                    Delete
                </button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div id="toast"
         class="fixed bottom-6 right-6 z-50 hidden items-center gap-3 px-5 py-3.5 bg-gray-900 text-white text-sm font-medium rounded-xl shadow-xl">
        <svg class="w-5 h-5 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="toastMessage">Done!</span>
    </div>
</div>

@section Scripts {
<script>
    let editingRow = null;
    let deletingRow = null;

    // ── Edit ──────────────────────────────────────────────────────────────────────
    function openEdit(row) {
        editingRow = row;
        document.getElementById("editName").value   = row.dataset.name;
        document.getElementById("editEmail").value  = row.dataset.email;
        document.getElementById("editRole").value   = row.dataset.role;
        document.getElementById("editStatus").value = row.dataset.status;
        openModal("editModal");
    }

    function saveEdit() {
        if (!editingRow) return;
        // Update visual (real persistence would need a form POST)
        const name = document.getElementById("editName").value.trim() || editingRow.dataset.name;
        const role = document.getElementById("editRole").value;
        editingRow.dataset.name = name;
        editingRow.dataset.role = role;
        // Update displayed name
        const nameEl = editingRow.querySelector("span.text-sm.font-semibold");
        if (nameEl) nameEl.textContent = name;
        closeModal("editModal");
        showToast("User updated successfully!");
    }

    // ── Delete ────────────────────────────────────────────────────────────────────
    function openDelete(row) {
        deletingRow = row;
        document.getElementById("deleteUserName").textContent = row.dataset.name;
        openModal("deleteModal");
    }

    function confirmDelete() {
        if (deletingRow) {
            deletingRow.remove();
        }
        closeModal("deleteModal");
        showToast("User deleted.");
    }

    // ── Modal helpers ─────────────────────────────────────────────────────────────
    function openModal(id) {
        const el = document.getElementById(id);
        el.classList.remove("hidden");
        el.classList.add("flex");
    }

    function closeModal(id) {
        const el = document.getElementById(id);
        el.classList.add("hidden");
        el.classList.remove("flex");
    }

    ["editModal", "deleteModal"].forEach(id => {
        document.getElementById(id).addEventListener("click", function (e) {
            if (e.target === this) closeModal(id);
        });
    });

    // ── Toast ─────────────────────────────────────────────────────────────────────
    function showToast(msg) {
        const toast = document.getElementById("toast");
        document.getElementById("toastMessage").textContent = msg;
        toast.classList.remove("hidden");
        toast.classList.add("flex");
        setTimeout(() => {
            toast.classList.add("hidden");
            toast.classList.remove("flex");
        }, 3000);
    }
</script>
}

    let editingId = null;

