@model List<Student_Management_System.Models.Attendance>

@{
    ViewData["Title"] = "Attendance";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var student = ViewBag.Student as Student_Management_System.Models.Student;

    int present = Model?.Count(a => a.Status == "Present") ?? 0;
    int absent  = Model?.Count(a => a.Status == "Absent")  ?? 0;
    int leave   = Model?.Count(a => a.Status == "Leave")   ?? 0;
    int late    = Model?.Count(a => a.Status == "Late")    ?? 0;
    int total   = Model?.Count ?? 0;
    int pct     = total > 0 ? (int)((float)present / total * 100) : 0;
}

<div class="max-w-6xl">
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-textDark mb-1">Attendance</h2>
        <p class="text-textMuted text-sm">Your complete attendance history.</p>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-xs font-medium text-textMuted mb-1">Overall</p>
            <p class="text-3xl font-bold text-textDark">@pct%</p>
            <p class="text-xs text-textMuted mt-1">@present / @total classes</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-xs font-medium text-textMuted mb-1">Present</p>
            <p class="text-3xl font-bold text-green-600">@present</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-xs font-medium text-textMuted mb-1">Absent</p>
            <p class="text-3xl font-bold text-red-500">@absent</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-xs font-medium text-textMuted mb-1">Leave / Late</p>
            <p class="text-3xl font-bold text-orange-500">@(leave + late)</p>
        </div>
    </div>

    <!-- Attendance Table -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
            <h3 class="text-base font-bold text-textDark">Attendance records</h3>
            <span class="text-xs text-textMuted">@total total records</span>
        </div>

        @if (!Model!.Any())
        {
            <div class="flex flex-col items-center justify-center py-16">
                <p class="text-sm text-textMuted">No attendance records found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="text-xs font-semibold text-textMuted uppercase tracking-wider bg-gray-50/60">
                            <th class="px-6 py-3">#</th>
                            <th class="px-6 py-3">Date</th>
                            <th class="px-6 py-3">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @{ int row = 1; }
                        @foreach (var record in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-3 text-textMuted">@row</td>
                                <td class="px-6 py-3 text-textDark font-medium whitespace-nowrap">
                                    @record.Date.ToString("dd MMM yyyy")
                                </td>
                                <td class="px-6 py-3 whitespace-nowrap">
                                    @if (record.Status == "Present")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-green-600">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Present
                                        </span>
                                    }
                                    else if (record.Status == "Absent")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-600">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Absent
                                        </span>
                                    }
                                    else if (record.Status == "Leave")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-600">
                                            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>Leave
                                        </span>
                                    }
                                    else if (record.Status == "Late")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-50 text-orange-600">
                                            <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>Late
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600">@record.Status</span>
                                    }
                                </td>
                            </tr>
                            row++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
