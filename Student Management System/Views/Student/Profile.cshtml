@model Student_Management_System.Models.Student?

@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    string initials = Model?.Initials ?? "S";
}

<div class="max-w-3xl">
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-textDark mb-1">My Profile</h2>
        <p class="text-textMuted text-sm">Your personal information on record.</p>
    </div>

    @if (Model == null)
    {
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm flex flex-col items-center justify-center py-20">
            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-400 flex items-center justify-center mb-4">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-textDark mb-1">Profile not found</h3>
            <p class="text-sm text-textMuted">No student record found for your account.</p>
        </div>
    }
    else
    {
        <!-- Profile Card -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <!-- Top banner + Avatar -->
            <div class="h-24 bg-gradient-to-r from-blue-500 to-blue-600 relative"></div>
            <div class="px-6 pb-6">
                <div class="flex items-end gap-4 -mt-8 mb-5">
                    <div class="w-16 h-16 rounded-2xl bg-white border-4 border-white shadow-md text-primary flex items-center justify-center text-xl font-bold flex-shrink-0">
                        @initials
                    </div>
                    <div class="pb-1">
                        <h3 class="text-lg font-bold text-textDark leading-tight">@Model.FullName</h3>
                        <p class="text-sm text-textMuted">@(Model.RollNo)</p>
                    </div>
                </div>

                <!-- Detail Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5">

                    <div>
                        <p class="text-xs font-semibold text-textMuted uppercase tracking-wide mb-1">Email</p>
                        <p class="text-sm font-medium text-textDark">@(Model.Email ?? "—")</p>
                    </div>

                    <div>
                        <p class="text-xs font-semibold text-textMuted uppercase tracking-wide mb-1">Phone</p>
                        <p class="text-sm font-medium text-textDark">@(Model.Phone ?? "—")</p>
                    </div>

                    <div>
                        <p class="text-xs font-semibold text-textMuted uppercase tracking-wide mb-1">Roll No.</p>
                        <p class="text-sm font-medium text-textDark">@Model.RollNo</p>
                    </div>

                    <div>
                        <p class="text-xs font-semibold text-textMuted uppercase tracking-wide mb-1">Date of Birth</p>
                        <p class="text-sm font-medium text-textDark">@(Model.Dob?.ToString("dd MMM yyyy") ?? "—")</p>
                    </div>

                    <div>
                        <p class="text-xs font-semibold text-textMuted uppercase tracking-wide mb-1">Enrolled On</p>
                        <p class="text-sm font-medium text-textDark">@(Model.EnrolledOn?.ToString("dd MMM yyyy") ?? "—")</p>
                    </div>

                    <div>
                        <p class="text-xs font-semibold text-textMuted uppercase tracking-wide mb-1">Address</p>
                        <p class="text-sm font-medium text-textDark">@(Model.Address ?? "—")</p>
                    </div>

                </div>
            </div>
        </div>
    }
</div>
