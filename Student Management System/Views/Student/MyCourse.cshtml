@model List<Student_Management_System.Models.Course>

@{
    ViewData["Title"] = "My Course";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var student = ViewBag.Student as Student_Management_System.Models.Student;
}

<div class="max-w-6xl">
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-textDark mb-1">My Course</h2>
        <p class="text-textMuted">Your enrolled courses and subjects this term.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm flex flex-col items-center justify-center py-24">
            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-400 flex items-center justify-center mb-4">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-textDark mb-1">No courses enrolled</h3>
            <p class="text-sm text-textMuted">You have not been enrolled in any course yet.</p>
        </div>
    }
    else
    {
        @foreach (var course in Model)
        {
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden mb-6">
                <!-- Course Header -->
                <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-xl bg-blue-50 text-primary flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-textDark">@course.CourseName</h3>
                            @if (!string.IsNullOrWhiteSpace(course.Duration))
                            {
                                <p class="text-sm text-textMuted">Duration: @course.Duration</p>
                            }
                        </div>
                    </div>
                    <span class="text-xs font-semibold bg-blue-50 text-primary px-3 py-1 rounded-full">
                        @course.Subjects.Count Subject(s)
                    </span>
                </div>

                <!-- Subjects List -->
                @if (course.Subjects.Any())
                {
                    <div class="divide-y divide-gray-50">
                        @foreach (var subject in course.Subjects)
                        {
                            <div class="flex items-center gap-3 px-6 py-3">
                                <div class="w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></div>
                                <span class="text-sm text-textDark">@subject.SubjectName</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="px-6 py-4">
                        <p class="text-sm text-textMuted italic">No subjects added to this course yet.</p>
                    </div>
                }
            </div>
        }
    }
</div>
